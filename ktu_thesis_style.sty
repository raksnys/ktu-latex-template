% =====================================================================
% Lentelių stilius — KTU 2026 šablonas (p. 24)
% --------------------------------------------------------------------
% • Kūnas: 10 pt, vienetinis intervalas (1,0), 3 pt papildoma eil. aukštis.
% • Antraštės eilutė lieka paryškinta (kviečiant \textbf{...} pačiame lentelės
%   kode); fonto dydis sutampa su kūnu (10 pt).
% • Vertikalios + horizontalios linijos pridedamos rankiniu būdu prie kiekvienos
%   lentelės (|p{..}| stulpeliai ir \hline, žr. pavyzdį chapters/01_analize.tex);
%   čia tik nustatomos linijos plotis ir pakeičiamos booktabs taisyklės į
%   standartinį \hline (vienodos linijos storis).
% =====================================================================
\setlength{\arrayrulewidth}{0.5pt}
\setlength{\extrarowheight}{3pt}
% Lentelės kūnas: 10 pt šriftas (KTU 2026 šablonas, p. 24).
% Font dydis nustatomas PRIEŠ \begin{tabular} įgyvendinant \begingroup..\endgroup,
% nes \AtBeginEnvironment kodas vykdomas tabular alignment-template fazėje, kur
% \selectfont sukelia „Misplaced \noalign" klaidą.
\BeforeBeginEnvironment{tabular}{\begingroup\fontsize{10pt}{12pt}\selectfont}
\AfterEndEnvironment{tabular}{\endgroup}
\BeforeBeginEnvironment{longtable}{\begingroup\fontsize{10pt}{12pt}\selectfont}
\AfterEndEnvironment{longtable}{\endgroup}
% Booktabs storesnės taisyklės -> standartinis vienodo storio \hline.
% Naudojame \let (be optional-arg overhead), nes jokia mūsų lentelė nenaudoja
% \toprule[width] sintaksės.
\AtBeginDocument{%
  \let\toprule\hline%
  \let\midrule\hline%
  \let\bottomrule\hline%
  \let\cmidrule\cline%
}

% =====================================================================
% Panaudojimo atvejo (PA) specifikacijos lentelė.
%
% Naudojimas (raktas=reikšmė; tvarka nesvarbi):
%   \usecasespec{
%     label=tab:pa-perziureti-tyrimus,
%     pa=Peržiūrėti visus tyrimus,
%     tikslas=Atvaizduoti visus tyrimus,
%     aprasymas={Prisijungęs naudotojas pasirenka nuorodą...},
%     pries=Naudotojas prisijungęs prie sistemos,
%     aktoriai={Laborantas, FoxLab},
%     ispleciantys=Peržiūrėti tyrimo informaciją,
%     apimami=--,
%     specializuojami=--,
%     po=Naudotojas mato visus tyrimus
%   }
%
% Reikšmes su kableliais reikia apgaubti riestiniais skliaustais ({}).
% Pavadinimas generuojamas automatiškai: ,,<pa>`` PA specifikacija.
% =====================================================================
\usepackage{keyval}
\makeatletter
\define@key{usecase}{label}{\def\ktu@uc@label{#1}}
\define@key{usecase}{pa}{\def\ktu@uc@pa{#1}}
\define@key{usecase}{tikslas}{\def\ktu@uc@tikslas{#1}}
\define@key{usecase}{aprasymas}{\def\ktu@uc@aprasymas{#1}}
\define@key{usecase}{pries}{\def\ktu@uc@pries{#1}}
\define@key{usecase}{aktoriai}{\def\ktu@uc@aktoriai{#1}}
\define@key{usecase}{ispleciantys}{\def\ktu@uc@ispleciantys{#1}}
\define@key{usecase}{apimami}{\def\ktu@uc@apimami{#1}}
\define@key{usecase}{specializuojami}{\def\ktu@uc@specializuojami{#1}}
\define@key{usecase}{po}{\def\ktu@uc@po{#1}}
\newcommand{\usecasespec}[1]{%
  \def\ktu@uc@label{}\def\ktu@uc@pa{}\def\ktu@uc@tikslas{}%
  \def\ktu@uc@aprasymas{}\def\ktu@uc@pries{}\def\ktu@uc@aktoriai{}%
  \def\ktu@uc@ispleciantys{--}\def\ktu@uc@apimami{--}%
  \def\ktu@uc@specializuojami{--}\def\ktu@uc@po{}%
  \setkeys{usecase}{#1}%
  \begin{table}[ht]
  \caption{,,\ktu@uc@pa`` PA specifikacija}\label{\ktu@uc@label}
  \begin{tabular}{|p{3.8cm}|p{3.4cm}|p{8.0cm}|}
  \hline
  \multicolumn{3}{|p{15.5cm}|}{\textbf{PA.} \ktu@uc@pa} \\ \hline
  \multicolumn{3}{|p{15.5cm}|}{\textbf{Tikslas.} \ktu@uc@tikslas} \\ \hline
  \multicolumn{3}{|p{15.5cm}|}{\textbf{Aprašymas.} \ktu@uc@aprasymas} \\ \hline
  \multicolumn{2}{|l|}{\textbf{Prieš sąlyga}} & \ktu@uc@pries \\ \hline
  \multicolumn{2}{|l|}{\textbf{Aktoriai}} & \ktu@uc@aktoriai \\ \hline
  \multirow{3}{=}{\textbf{Susiję panaudojimo atvejai}}
    & \textbf{Išplečiantys PA} & \ktu@uc@ispleciantys \\ \cline{2-3}
    & \textbf{Apimami PA} & \ktu@uc@apimami \\ \cline{2-3}
    & \textbf{Specializuojami PA} & \ktu@uc@specializuojami \\ \hline
  \multicolumn{2}{|l|}{\textbf{Po sąlyga}} & \ktu@uc@po \\ \hline
  \end{tabular}
  \end{table}%
}
\makeatother

