% =====================================================================
% Priedų numeravimas — pagal KTU 2026 šabloną.
% \priedas{Pavadinimas} sukuria paryškintą antraštę „N priedas. Pavadinimas"
% ir įkelia ją į turinį kaip poskyrį po „Priedai" skyriaus.
% =====================================================================
\newcounter{priedas}
\renewcommand{\thepriedas}{\arabic{priedas}}
\newcommand{\priedas}[1]{%
  \refstepcounter{priedas}%
  \par\bigskip%
  \phantomsection%
  \addcontentsline{toc}{subsection}{\thepriedas~priedas. #1}%
  \noindent\textbf{\thepriedas~priedas. #1}%
  \par\medskip%
}
